{
  "name": "small-style",
  "version": "1.1.1",
  "description": "Small styling framework - customizable SCSS framework",
  "license": "MIT",
  "keywords": [
    "scss",
    "sass",
    "css",
    "design-system",
    "tokens",
    "utilities"
  ],
  "homepage": "https://github.com/jslinky/gardners-styles#readme",
  "bugs": {
    "url": "https://github.com/jslinky/gardners-styles/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jslinky/gardners-styles.git"
  },
  "main": "dist/style.css",
  "sass": "scss/index.scss",
  "style": "dist/style.css",
  "exports": {
    ".": "./dist/style.css",
    "./dist/*": "./dist/*",
    "./scss/*": "./scss/*",
    "./scripts/*": "./scripts/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scss/",
    "scripts/",
    "templates/"
  ],
  "scripts": {
    "postinstall": "node scripts/setup.js",
    "build": "sass scss/index.scss:dist/style.css --style=compressed --load-path=node_modules",    
    "build:reset": "sass scss/base/output-modules/_reset.scss:dist/modules/reset.css --load-path=node_modules",
    "build:base": "sass scss/base/output-modules/_base.scss:dist/modules/base.css --load-path=node_modules",
    "build:fluid-type": "sass scss/base/output-modules/components/typography/_fluid-type.scss:dist/modules/components/typography/fluid-type.css --load-path=node_modules",
    "build:headings": "sass scss/base/output-modules/components/typography/_headings.scss:dist/modules/components/typography/headings.css --load-path=node_modules",
    "build:buttons": "sass scss/base/output-modules/components/_buttons.scss:dist/modules/components/buttons.css --load-path=node_modules",
    "build:card": "sass scss/base/output-modules/components/_card.scss:dist/modules/components/card.css --load-path=node_modules",
    "build:collapse": "sass scss/base/output-modules/components/_collapse.scss:dist/modules/components/collapse.css --load-path=node_modules",
    "build:flow": "sass scss/base/output-modules/components/_flow.scss:dist/modules/components/flow.css --load-path=node_modules",
    "build:forms": "sass scss/base/output-modules/components/_forms.scss:dist/modules/components/forms.css --load-path=node_modules",
    "build:surface": "sass scss/base/output-modules/components/_surface.scss:dist/modules/components/surface.css --load-path=node_modules",
    "build:timeline": "sass scss/base/output-modules/components/_timeline.scss:dist/modules/components/timeline.css --load-path=node_modules",
    "build:layout": "sass scss/base/output-modules/components/_layout.scss:dist/modules/components/layout.css --load-path=node_modules",
    "build:color-props": "sass scss/base/output-modules/props/_colors.scss:dist/modules/props/colors.css --load-path=node_modules",
    "build:font-size-props": "sass scss/base/output-modules/props/_font-size.scss:dist/modules/props/font-size.css --load-path=node_modules",
    "build:font-props": "sass scss/base/output-modules/props/_font.scss:dist/modules/props/font.css --load-path=node_modules",
    "build:forms-props": "sass scss/base/output-modules/props/_forms.scss:dist/modules/props/forms.css --load-path=node_modules",
    "build:layout-props": "sass scss/base/output-modules/props/_layout.scss:dist/modules/props/layout.css --load-path=node_modules",
    "build:spacing-props": "sass scss/base/output-modules/props/_spacing.scss:dist/modules/props/spacing.css --load-path=node_modules",    
    "build:theme-color-props": "sass scss/base/output-modules/props/theme/_colors.scss:dist/modules/props/theme/colors.css --load-path=node_modules",
    "build:theme-font-size-props": "sass scss/base/output-modules/props/theme/_font-size.scss:dist/modules/props/theme/font-size.css --load-path=node_modules",
    "build:theme-font-props": "sass scss/base/output-modules/props/theme/_font.scss:dist/modules/props/theme/font.css --load-path=node_modules",
    "build:theme-forms-props": "sass scss/base/output-modules/props/theme/_forms.scss:dist/modules/props/theme/forms.css --load-path=node_modules",
    "build:theme-layout-props": "sass scss/base/output-modules/props/theme/_layout.scss:dist/modules/props/theme/layout.css --load-path=node_modules",
    "build:theme-spacing-props": "sass scss/base/output-modules/props/theme/_spacing.scss:dist/modules/props/theme/spacing.css --load-path=node_modules",
    "build:register-props": "sass scss/base/rules/props/_registration.scss:dist/modules/props/registration.css --load-path=node_modules",
    "build:register-key-tokens-props": "mkdir -p dist/modules/props/registration && sass scss/base/rules/props/registration/_key-tokens.scss:dist/modules/props/registration/key-tokens.css --load-path=node_modules",
    "build:register-font-size-props": "mkdir -p dist/modules/props/registration && sass scss/base/rules/props/registration/_font-size.scss:dist/modules/props/registration/font-size.css --load-path=node_modules",
    "build:register-font-props": "mkdir -p dist/modules/props/registration && sass scss/base/rules/props/registration/_font.scss:dist/modules/props/registration/font.css --load-path=node_modules",
    "build:register-spacing-props": "mkdir -p dist/modules/props/registration && sass scss/base/rules/props/registration/_spacing.scss:dist/modules/props/registration/spacing.css --load-path=node_modules",
    "build:register-wrapper-props": "mkdir -p dist/modules/props/registration && sass scss/base/rules/props/registration/_wrapper.scss:dist/modules/props/registration/wrapper.css --load-path=node_modules",
    "build:register-layout-props": "mkdir -p dist/modules/props/registration && sass scss/base/rules/props/registration/_layout.scss:dist/modules/props/registration/layout.css --load-path=node_modules",
    "build:register-color-props": "mkdir -p dist/modules/props/registration && sass scss/base/rules/props/registration/_colors.scss:dist/modules/props/registration/colors.css --load-path=node_modules",
    "build:register-props-modules": "npm run build:register-key-tokens-props && npm run build:register-font-size-props && npm run build:register-font-props && npm run build:register-spacing-props && npm run build:register-wrapper-props && npm run build:register-layout-props && npm run build:register-color-props",
    "build:all-props": "npm run build:color-props && npm run build:font-size-props && npm run build:font-props && npm run build:forms-props && npm run build:layout-props && npm run build:spacing-props && npm run build:theme-color-props && npm run build:theme-font-size-props && npm run build:theme-font-props && npm run build:theme-forms-props && npm run build:theme-layout-props && npm run build:theme-spacing-props",
    "build:components": "npm run build:reset && npm run build:base && npm run build:fluid-type && npm run build:headings && npm run build:buttons && npm run build:card && npm run build:collapse && npm run build:flow && npm run build:forms && npm run build:surface && npm run build:timeline && npm run build:layout",
    "build:all": "npm run build && npm run build:all-props && npm run build:register-props && npm run build:register-props-modules && npm run build:components",
    "prepack": "npm run build:all",
    "prepare": "npm run build:all",
    "watch": "sass scss/style.scss:dist/style.css --watch --load-path=node_modules"
  },
  "devDependencies": {
    "sass": "^1.70.0"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
  "dependencies": {
    "open-props-scss": "^0.8.0"
  }
}
